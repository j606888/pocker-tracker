generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String
  name         String?
  /// Optional bankroll (TWD) — the report shows it in buy-ins.
  bankroll     Int?
  createdAt    DateTime      @default(now())

  levelPresets LevelPreset[]
  venues       Venue[]
  sessions     Session[]
}

/// Back-office operator. Fully separate from User: its own credentials, its
/// own /admin/login. An admin can impersonate any User read-only.
model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
}

/// One "admin started impersonating a user" event. Emails are snapshotted (no
/// FK) so the trail survives Admin/User deletion.
model ImpersonationLog {
  id         String   @id @default(cuid())
  adminId    String
  adminEmail String
  userId     String
  userEmail  String
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

/// Per-user quick-entry level (e.g. "6600"): tapping a chip fills the buy-in.
model LevelPreset {
  id        String    @id @default(cuid())
  userId    String
  label     String
  buyIn     Int
  sortOrder Int       @default(0)

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions  Session[]

  @@index([userId])
}

/// Per-user quick-entry venue (e.g. "俱樂部 A"), managed like LevelPreset.
model Venue {
  id        String    @id @default(cuid())
  userId    String
  name      String
  sortOrder Int       @default(0)

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions  Session[]

  @@index([userId])
}

/// How the player felt during a session (optional, one tap when saving).
enum Mood {
  FOCUSED
  NORMAL
  TIRED
  TILT
}

/// One poker session. Net = cashOut - buyIn - rake (computed at read time).
/// buyIn is the TOTAL put in, rebuys included; `rebuys` only records how many.
model Session {
  id            String       @id @default(cuid())
  userId        String
  playedAt      DateTime     @db.Date
  levelPresetId String?
  venueId       String?
  buyIn         Int
  rebuys        Int          @default(0)
  cashOut       Int
  rake          Int          @default(0)
  mood          Mood?
  note          String?
  createdAt     DateTime     @default(now())

  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  levelPreset   LevelPreset? @relation(fields: [levelPresetId], references: [id], onDelete: SetNull)
  venue         Venue?       @relation(fields: [venueId], references: [id], onDelete: SetNull)

  @@index([userId, playedAt])
}
